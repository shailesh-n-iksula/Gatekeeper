# Copy to .env for local runs. In CI, store the whole file as ONE secret named QA_ENV_FILE.
# Never put live/production payment keys here. Sandbox and staging values only.

# staging (default) | production (production runs ONLY @synthetic read-only tests)
TARGET_ENV=staging

# Staging behind HTTP basic auth? (common for Magento staging)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# ---- Magento / Adobe Commerce ----
# Integration access token (System > Extensions > Integrations). Used only to delete
# test customers after a run. Optional: without it, the nightly janitor must clean up.
MAGENTO_ADMIN_TOKEN=

# ---- Shopify ----
# Storefront API public access token (Headless channel or custom app). Enables API cart tests.
SHOPIFY_STOREFRONT_TOKEN=
# Password for a password-protected development/staging store.
SHOPIFY_STOREFRONT_PASSWORD=

# ---- Pre-created accounts (only where the platform cannot create them by API) ----
QA_CUSTOMER_EMAIL=
QA_CUSTOMER_PASSWORD=

# B2B personas referenced by client.config.ts -> b2b.tierPrices[].persona
# B2B_GOLD_EMAIL=
# B2B_GOLD_PASSWORD=

# Emails for created test customers go to this domain. example.com never delivers mail.
TEST_EMAIL_DOMAIN=example.com

# Tuning
# WORKERS=4               # keep low against small shared staging servers
# BLOCK_THIRD_PARTIES=0   # set 0 only for a tag/analytics audit run
